@{
    ViewData["Title"] = "About";
}

<div class="row justify-content-center py-3 py-md-4">
    <div class="col-lg-8">
        <h1 class="mb-4">About</h1>

        <section aria-labelledby="project-heading" class="mb-5">
            <h2 id="project-heading" class="h4">NASA APOD Gallery</h2>
            <p>
                A small window into the universe, built with ASP.NET Core MVC.
                Choose a date range to explore NASA's Astronomy Picture of the Day,
                save the records, and revisit them in the gallery.
            </p>
            <p class="text-muted">
                The project combines NASA's APOD API, SQL Server, and ADO.NET
                with parameterized queries. It was built as a software engineering
                technical assignment, with a focus on clear structure and reliable data storage.
            </p>
        </section>

        <section aria-labelledby="developer-heading">
            <h2 id="developer-heading" class="h4">Hi, I'm Shakila Thathsara.</h2>
            <p>
                I'm a final-year Information Systems undergraduate at the
                University of Colombo School of Computing, interested in building
                reliable, user-focused software.
            </p>

